# Modbus simulator
MODBUS_HOST=127.0.0.1
MODBUS_PORT=5020
CSV_PATH=data/sample.csv

# MQTT broker
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=factory/line1/device01/telemetry

# Gateway
DEVICE_ID=device01
POLL_INTERVAL=1.0

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=iot_telemetry
POSTGRES_USER=iot
POSTGRES_PASSWORD=iotpass

# Ingestor batching
BATCH_SIZE=50
FLUSH_INTERVAL=2.0
